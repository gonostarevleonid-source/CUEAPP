<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CueApp.App.ViewModels"
        xmlns:app="using:CueApp.App"
        xmlns:views="using:CueApp.App.Views"
        xmlns:insp="using:CueApp.App.ViewModels.Inspector"
        x:Class="CueApp.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        Width="1280" Height="760"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">

    <!-- Esc = STOP работает всегда, даже в поле ввода.
         Пробел (GO), Delete и горячие клавиши меню «Файл» — в MainWindow.axaml.cs:
         пробел и Delete не должны срабатывать, пока вы печатаете в поле инспектора -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding StopCommand}" />
    </Window.KeyBindings>

    <!-- Меню: на Mac — в верхней строке экрана, на Windows — полоской в окне (NativeMenuBar ниже) -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="Файл">
                <NativeMenu>
                    <NativeMenuItem Header="Новое шоу" Command="{Binding NewShowCommand}"
                                    Gesture="{x:Static app:Hotkeys.NewShow}" />
                    <NativeMenuItem Header="Открыть…" Command="{Binding OpenShowCommand}"
                                    Gesture="{x:Static app:Hotkeys.OpenShow}" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="Сохранить" Command="{Binding SaveShowCommand}"
                                    Gesture="{x:Static app:Hotkeys.SaveShow}" />
                    <NativeMenuItem Header="Сохранить как…" Command="{Binding SaveShowAsCommand}"
                                    Gesture="{x:Static app:Hotkeys.SaveShowAs}" />
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <Window.Styles>
        <!-- Кнопки не забирают фокус клавиатуры: иначе Пробел нажал бы, например, PANIC вместо GO -->
        <Style Selector="Button">
            <Setter Property="Focusable" Value="False" />
        </Style>

        <!-- Кнопки шапки и панели: тема Fluent при наведении красит их серым — держим свои цвета -->
        <Style Selector="Button.go:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource GoBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.go:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="Button.panic:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3A1416" />
            <Setter Property="BorderBrush" Value="{StaticResource PanicBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PanicTextBrush}" />
        </Style>

        <!-- Кью-лист: убираем стандартную подсветку Fluent, рисуем выделение сами -->
        <Style Selector="ListBox.cues ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="ListBox.cues ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.cues ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.cues ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.cues ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.cues ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.cues ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Выбранная кью («уйдет по GO»): белая обводка + зеленая полоска слева.
             Цвета по умолчанию задаются здесь, а не в разметке: значение в разметке сильнее стиля -->
        <Style Selector="Border.outline">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.flag">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Играющая кью: синяя полоска (у выбранной зеленая важнее — стиль ниже) -->
        <Style Selector="Border.flag.playing">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="TextBlock.duration.playing">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.duration.missing">
            <Setter Property="Foreground" Value="{StaticResource WarningRedBrush}" />
        </Style>
        <Style Selector="Border.outline.selected">
            <Setter Property="BorderBrush" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="Border.flag.selected">
            <Setter Property="Background" Value="{StaticResource GoBrush}" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Полоска меню; на Mac не видна — там меню в строке экрана -->
        <NativeMenuBar DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" />

        <!-- ШАПКА -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel2Brush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock FontWeight="Bold" FontSize="15" LetterSpacing="0.6">
                        <Run Text="CUE" Foreground="{StaticResource AccentBrush}" /><Run Text="APP" />
                    </TextBlock>
                    <TextBlock Classes="secondary" FontSize="12">
                        <Run Text="{Binding ShowTitle}" /><Run Text=" · " /><Run Text="{Binding FileLabel}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Classes="panic" Command="{Binding PanicCommand}" MinWidth="84" Height="64"
                            Background="#2A1214" Foreground="{StaticResource PanicTextBrush}"
                            BorderBrush="{StaticResource PanicBrush}" BorderThickness="1" CornerRadius="6"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            FontWeight="Bold" Content="PANIC" />
                    <Button Classes="tool" Command="{Binding StopCommand}" MinWidth="76" Height="64"
                            CornerRadius="6" FontSize="13" FontWeight="Bold"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Content="STOP" />
                    <Button Classes="go" Command="{Binding GoCommand}" MinWidth="140" Height="64"
                            Background="{StaticResource GoBrush}" Foreground="White" CornerRadius="6"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            FontSize="26" FontWeight="ExtraBold" LetterSpacing="1.5" Content="GO" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- СТРОКА СТАТУСА -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="16,6">
            <TextBlock Text="{Binding Status}" Classes="mono secondary" FontSize="12" />
        </Border>

        <!-- ПАНЕЛЬ «ДОБАВИТЬ» -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel2Brush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding CueCountText}" Classes="secondary"
                           FontSize="12" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Добавить:" Classes="secondary" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Classes="tool" Command="{Binding AddCueCommand}" CommandParameter="Track">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource CueTrackBrush}" />
                            <TextBlock Text="Трек" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tool" Command="{Binding AddCueCommand}" CommandParameter="Stop">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource CueStopBrush}" />
                            <TextBlock Text="Stop" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tool" Command="{Binding AddCueCommand}" CommandParameter="Group">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource CueGroupBrush}" />
                            <TextBlock Text="Group" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Background="{StaticResource LineBrush}" Margin="6,2" />
                    <Button Classes="tool" Command="{Binding DeleteCueCommand}" Content="Удалить" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid ColumnDefinitions="*,360">
        <!-- СПРАВА: заметки + инспектор выбранной кью -->
        <Border Grid.Column="1" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
            <Panel>
                <TextBlock Text="Выберите кью, чтобы увидеть заметки и настройки"
                           Classes="secondary" FontSize="12" TextWrapping="Wrap" Margin="16"
                           IsVisible="{Binding Inspector, Converter={x:Static ObjectConverters.IsNull}}" />
                <ContentControl Content="{Binding Inspector}">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="insp:InspectorViewModel">
                            <views:InspectorView />
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </Panel>
        </Border>

        <!-- КЬЮ-ЛИСТ -->
        <DockPanel Grid.Column="0">
            <!-- Заголовок таблицы: те же колонки, что у строк -->
            <Border DockPanel.Dock="Top" Background="{StaticResource TableHeaderBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                    Padding="0,8">
                <Grid ColumnDefinitions="6,54,92,*,120,110" TextElement.FontSize="11"
                      TextElement.Foreground="{StaticResource TextSecondaryBrush}">
                    <TextBlock Grid.Column="1" Text="№" Margin="12,0,0,0" />
                    <TextBlock Grid.Column="2" Text="ТИП" LetterSpacing="0.6" />
                    <TextBlock Grid.Column="3" Text="НАЗВАНИЕ" LetterSpacing="0.6" />
                    <TextBlock Grid.Column="4" Text="СТАРТ TC" LetterSpacing="0.6" />
                    <TextBlock Grid.Column="5" Text="ДЛИТЕЛЬНОСТЬ" LetterSpacing="0.6" />
                </Grid>
            </Border>

            <!-- Focusable — чтобы было куда увести фокус из поля ввода, даже когда список пуст -->
            <ListBox x:Name="CueList" Classes="cues" Focusable="True"
                     ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CueRowViewModel">
                        <!-- Подкью: вся строка смещена вправо (RowMargin), правые колонки остаются выровнены -->
                        <Border Margin="{Binding RowMargin}" Background="{Binding RowBackground}"
                                BorderBrush="{StaticResource RowLineBrush}" BorderThickness="0,0,0,1"
                                MinHeight="44">
                            <Panel>
                                <Grid ColumnDefinitions="6,54,92,*,120,110">
                                    <!-- Тонкая вертикальная линия у подкью -->
                                    <Rectangle Width="2" HorizontalAlignment="Left"
                                               Fill="{StaticResource SubCueGuideBrush}"
                                               IsVisible="{Binding IsSubCue}" />
                                    <!-- Полоска состояния: зеленая у выбранной -->
                                    <Border Classes="flag" Classes.selected="{Binding IsSelected}"
                                            Classes.playing="{Binding IsPlaying}" />

                                    <TextBlock Grid.Column="1" Classes="mono" Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding Number}" FontWeight="{Binding NumberWeight}" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <Border Width="8" Height="8" CornerRadius="2" Background="{Binding TypeBrush}" />
                                        <TextBlock Text="{Binding TypeLabel}" Foreground="{Binding TypeBrush}"
                                                   FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="{Binding Name}" FontWeight="Medium"
                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Column="4" Classes="mono" VerticalAlignment="Center"
                                               Foreground="{StaticResource TimecodeBrush}"
                                               Text="{Binding StartTimecode}" />
                                    <TextBlock Grid.Column="5" Classes="mono duration" VerticalAlignment="Center"
                                               Classes.playing="{Binding IsPlaying}"
                                               Classes.missing="{Binding IsMissingFile}"
                                               Text="{Binding Duration}" />
                                </Grid>
                                <!-- Обводка выбранной строки (белая — в стилях выше) -->
                                <Border Classes="outline" Classes.selected="{Binding IsSelected}" />
                                <!-- Перетаскивание файлов: новые треки встанут под этой линией -->
                                <Border Height="3" VerticalAlignment="Bottom" Background="{StaticResource AccentBrush}"
                                        IsVisible="{Binding IsDropTarget}" />
                            </Panel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        </Grid>
    </DockPanel>
</Window>
